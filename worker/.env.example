# Always required
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=

# Multi-tenant mode. Leave INTERNAL_API_SECRET unset for single-tenant dev mode
# (agent settings then come from the dev-mode variables below).
CONTROL_PLANE_URL=http://localhost:3000
INTERNAL_API_SECRET=

# ---------------------------------------------------------------------------
# Dev mode only: the agent. Ignored once INTERNAL_API_SECRET is set (each agent's
# stored config is used instead). Every line below shows its default; uncomment
# to change it. A blank value also means "use the default".
# ---------------------------------------------------------------------------

# Persona: assistant, kbs, cheerful, concise, support, tutor, professional.
# AGENT_INSTRUCTIONS replaces the persona's prompt (voice rules are still added).
# AGENT_GREETING replaces the persona's greeting (an instruction, not exact words).
AGENT_PERSONA=
AGENT_INSTRUCTIONS=
AGENT_GREETING=
# IANA time zone; picks the closing line ("good night" etc.) by hour.
AGENT_TIMEZONE=Asia/Kolkata

# Speech-to-text
# STT_MODEL=saaras:v4              # saaras:v3, saaras:v4
# STT_MODE=codemix                 # transcribe, translate, verbatim, translit, codemix
# STT_LANGUAGE=hi-IN               # a hint; "unknown" auto-detects
# STT_REALTIME=true                # streaming STT; false = send each utterance whole

# LLM
# LLM_MODEL=sarvam-105b-conversations   # others need Sarvam beta: sarvam-105b, gemma4, glm5.2
# LLM_TEMPERATURE=                 # 0-2; blank = model default
# MAX_RESPONSE_TOKENS=             # whole number > 0; blank = no limit

# Text-to-speech
TTS_MODEL=bulbul:v3              # bulbul:v3, bulbul:v3-beta, bulbul:v2
TTS_LANGUAGE=hi-IN               # bn, en, gu, hi, kn, ml, mr, od, pa, ta, te (all -IN)
TTS_SPEAKER=shruti               # must be a voice of TTS_MODEL (bulbul:v2 default: anushka)
#   bulbul:v3: shubh ritu rahul pooja simran kavya amit ratan rohan dev ishita shreya manan
#              sumit priya aditya kabir neha varun roopa aayan ashutosh advait amelia sophia
#              suhani rupali tanya shruti kavitha
#   bulbul:v2: anushka manisha vidya arya abhilash karun hitesh
# TTS_PACE=1.0                     # 0.3-3.0

# Cost limits (Rs). See cost/rate_ceiling.py and cost/call_budget.py.
MAX_INR_PER_MIN=2.2              # per-minute ceiling, 1.0-2.5; 0 = platform ceiling (2.5)
# CALL_BUDGET_INR=0                # per-call budget; 0 = off
# CALL_BUDGET_WARN_AT=0.70         # fraction of the budget: agent told to wind down
# CALL_BUDGET_WRAP_AT=0.90         # fraction of the budget: agent says goodbye; >= WARN_AT
# CALL_BUDGET_FAREWELL=            # instruction for that goodbye; blank = built-in

# Turn taking
USE_TURN_DETECTOR=true
VAD_MIN_SILENCE_DURATION=0.25    # seconds; >= 0.25 with the turn detector on
VAD_MIN_SPEECH_DURATION=0.05     # seconds
VAD_ACTIVATION_THRESHOLD=0.5     # 0-1, higher = needs louder speech
VAD_PREFIX_PADDING_DURATION=0.5  # seconds
# ENDPOINTING_MIN_DELAY=           # seconds; blank = 0.3 (detector on) / 0.5 (off)
# ENDPOINTING_MAX_DELAY=           # seconds; blank = 2.5 (detector on) / 3.0 (off)

# Silent caller: after SILENCE_TIMEOUT seconds with nobody speaking, the agent asks
# "are you still there?"; after SILENCE_CHECKS such checks, it says goodbye and hangs up.
SILENCE_TIMEOUT=10               # seconds, 5-120
SILENCE_CHECKS=1         # 0-5; 0 = never hang up on silence

# Call control
END_CALL_ENABLED=true            # agent may end the call itself
DTMF_INPUT=true                  # caller's keypad presses reach the agent

# Answering machines (outbound calls only)
VOICEMAIL_DETECTION=true
VOICEMAIL_ACTION=hangup          # hangup, leave_message
# VOICEMAIL_MESSAGE=               # blank = the model writes one

# Failover to LiveKit Inference when Sarvam fails (billed by LiveKit). Blank = off.
# Valid names come from livekit-agents, e.g. deepgram/nova-3, openai/gpt-4.1-mini,
# cartesia/sonic-3; an invalid one is rejected at startup with the full list.
# FALLBACK_STT=
# FALLBACK_LLM=
# FALLBACK_TTS=
# FALLBACK_TTS_VOICE=              # voice id for FALLBACK_TTS; blank = its default

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Worker processes kept warm for the next call (~280 MB each). Default 2.
WORKER_IDLE_PROCESSES=

# ---------------------------------------------------------------------------
# Telephony: Plivo <-> LiveKit SIP. Checked at startup when enabled.
# ---------------------------------------------------------------------------
TELEPHONY_ENABLED=false
# Your numbers, E.164, comma separated. Scope the inbound trunk; outbound caller IDs.
PLIVO_PHONE_NUMBERS=
# ap, us, eu, or a full hostname.
PLIVO_SIP_ZONE=ap
# One credential pair both ways. Set these or PLIVO_ALLOWED_ADDRESSES (or both).
PLIVO_SIP_USERNAME=
PLIVO_SIP_PASSWORD=
# Plivo's signalling IPs, comma separated: only they may send calls to the inbound trunk.
PLIVO_ALLOWED_ADDRESSES=
# Name the worker registers under; the dispatch rule sends calls to it.
TELEPHONY_AGENT_NAME=
# Room names are <prefix>-xxxx, one room per call.
TELEPHONY_ROOM_PREFIX=call
# Krisp noise cancellation at the LiveKit SIP trunk.
TELEPHONY_KRISP=true
# Hard cap on call length in seconds; blank = none.
TELEPHONY_MAX_CALL_SECONDS=
# How long an outbound call rings before it counts as no answer; blank = LiveKit default.
TELEPHONY_RINGING_SECONDS=
# Optional; blank = look up the trunk named plivo-outbound once per process.
TELEPHONY_OUTBOUND_TRUNK_ID=

# ---------------------------------------------------------------------------
# Recording: DigitalOcean Spaces in Bangalore via its S3 API (write access).
# Local dev: MinIO from compose.yaml (RECORDING_S3_ENDPOINT=http://localhost:9000).
# Recording is off unless bucket and both keys are set.
# ---------------------------------------------------------------------------
RECORDING_S3_BUCKET=automitra-recordings
RECORDING_S3_REGION=blr1
RECORDING_S3_ENDPOINT=https://blr1.digitaloceanspaces.com
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
# RECORDING_S3_PREFIX=recordings
