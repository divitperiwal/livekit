{$API_DOMAIN} {
	# Uploads: KYC carries two documents of up to 5 MB each, complaint proof one of up to
	# 10 MB; every other body stays small. The two matchers exclude each other, so their
	# order does not matter.
	@upload path_regexp ^/v1/orgs/[^/]+/(number-kyc|ucc-complaints/[^/]+/proof)$
	@otherRequests not path_regexp ^/v1/orgs/[^/]+/(number-kyc|ucc-complaints/[^/]+/proof)$
	request_body @upload {
		max_size 12MB
	}
	request_body @otherRequests {
		max_size 1MB
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	# Plivo's callbacks (KYC decisions). Each URL carries its own token.
	handle /plivo/* {
		reverse_proxy api:3000
	}

	# /internal and anything else stay on the Docker network.
	handle {
		header Content-Type application/json
		respond `{"error":"not found"}` 404
	}
}
