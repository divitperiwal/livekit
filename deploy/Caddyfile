{$API_DOMAIN} {
	# KYC uploads carry two documents of up to 5 MB each; every other body stays small.
	# The two matchers exclude each other, so their order does not matter.
	@kycUpload path_regexp ^/v1/orgs/[^/]+/number-kyc$
	@otherRequests not path_regexp ^/v1/orgs/[^/]+/number-kyc$
	request_body @kycUpload {
		max_size 12MB
	}
	request_body @otherRequests {
		max_size 1MB
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	# Plivo's callbacks (KYC decisions). Each URL carries its own token.
	handle /plivo/* {
		reverse_proxy api:3000
	}

	# /internal and anything else stay on the Docker network.
	handle {
		header Content-Type application/json
		respond `{"error":"not found"}` 404
	}
}
