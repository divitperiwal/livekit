# Copy to deploy/.env on the Droplet (chmod 600). Every line is required unless marked optional.

# Public hostname for /v1; its DNS A record points at the Droplet. Caddy gets the certificate.
API_DOMAIN=

# Database. URL-safe characters only (it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
# Shared by the api and the workers; 32+ characters: openssl rand -hex 32
INTERNAL_API_SECRET=
# Encrypts secrets stored in the database: openssl rand -base64 32
SECRETS_KEY=

# LiveKit Cloud (India South). The workers register as TELEPHONY_AGENT_NAME; the api
# dispatches outbound calls to it.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TELEPHONY_AGENT_NAME=automitra

SARVAM_API_KEY=

# Plivo REST API (Console > Overview): buying, linking and releasing numbers, and KYC.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The Zentrunk inbound trunk (towards LiveKit) every rented number answers on.
PLIVO_INBOUND_TRUNK_ID=

# Plivo Zentrunk. The LiveKit trunks list no numbers (they are rented while running):
# the inbound one accepts any number, but only from these Plivo signalling IPs/CIDRs.
# LiveKit support must enable allowed_addresses on the project. SIP credentials are
# optional (both or neither); the outbound trunk presents them to Plivo.
PLIVO_ALLOWED_ADDRESSES=
PLIVO_SIP_USERNAME=
PLIVO_SIP_PASSWORD=

# Hard cap on a call's length (10 minutes). A worker stop waits this long for live
# calls, plus 240 s for the recording upload (120 s), analysis (45 s) and finalize
# retries (60 s): deploy.sh refuses a grace period under TELEPHONY_MAX_CALL_SECONDS + 240.
TELEPHONY_MAX_CALL_SECONDS=600
WORKER_STOP_GRACE_SECONDS=840

# Recordings: a Spaces bucket in BLR1. The key needs read, write and delete: the
# workers upload, the api signs download links, and the background process deletes
# recordings past retention.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=blr1
RECORDING_S3_ENDPOINT=https://blr1.digitaloceanspaces.com
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# Database backups: a separate Spaces bucket, no lifecycle rules (pgBackRest expires
# its own files). The endpoint is a hostname, without https://.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=blr1
BACKUP_S3_ENDPOINT=blr1.digitaloceanspaces.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Encrypts the backups. Keep a copy outside the Droplet: without it no backup restores.
BACKUP_ENCRYPTION_PASSPHRASE=
