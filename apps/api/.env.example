# The control plane.

PORT=3000
DATABASE_URL=postgres://automitra:automitra@localhost:5432/automitra
REDIS_URL=redis://localhost:6379

# Shared secret the worker presents on /internal/*. Required, with no default:
# a development default would eventually reach production and fail silently.
#
# These endpoints serve any tenant's configuration and accept writes against
# any call, so they belong on a private network. This secret is the second
# lock, not the only one.
INTERNAL_API_SECRET=

# Development seed password for owner@kbsmotors.test. Only used by db:seed.
SEED_PASSWORD=automitra-dev

# Encrypts stored secrets at rest -- tool credentials and webhook signing
# secrets: 32 random bytes, base64. Generate one with
#   openssl rand -base64 32
# Needed once either is used; saving one without it fails rather than storing
# the secret in the clear. Keep it out of database backups.
SECRETS_KEY=

# --- Dispatching agents (`bun run background`, and POST /v1/calls) ---
# Both dispatch the agent through LiveKit, so they need the same credentials
# and agent name the worker registers under.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TELEPHONY_AGENT_NAME=
# How often it looks for work, and the most calls one campaign may run at once.
DIALER_TICK_MS=5000
DIALER_MAX_CONCURRENCY=50

# Requests per API key per minute on the public API.
PUBLIC_API_RATE_PER_MIN=300

# --- Call recordings: an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) ---
# The worker writes recordings; the API signs playback links and the
# background process deletes expired ones, so read-and-delete credentials are
# enough here. ENDPOINT is empty for AWS itself.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
