{
  "name": "automitra-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "cli": "bun src/cli.ts",
    "background": "bun src/background.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "livekit-server-sdk": "^2.19.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
