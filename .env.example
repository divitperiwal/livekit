# --- LiveKit connection (required) ---
# From your LiveKit Cloud project settings, or your self-hosted server.
# LiveKit carries the audio; the models are all Sarvam.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Sarvam (required) ---
# One key covers speech, language and voice. Get it at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Sarvam bills natively in INR. Run `uv run costs` to price your configuration.

# --- Speech to text (Saaras) ---
# saaras:v4 is current; saaras:v3 is the previous generation.
STT_MODEL=saaras:v4
# How mixed-language speech is written down:
#   codemix    - keeps English+Hindi as spoken (best for Hinglish callers)
#   transcribe - native script of the source language
#   translit   - romanised, Hindi written in Latin script
#   translate  - translated into English
#   verbatim   - literal, including disfluencies
STT_MODE=codemix
# Source language hint, e.g. hi-IN, en-IN, ta-IN. Use unknown to auto-detect.
STT_LANGUAGE=hi-IN

# --- Large language model ---
# One of: sarvam-105b-conversations, sarvam-105b, gemma4, glm5.2
# sarvam-105b-conversations is tuned for multi-turn dialogue and is the model
# generally available. The other three are gated behind beta access and return
# "This endpoint is currently in beta" unless your account is enabled for them.
LLM_MODEL=sarvam-105b-conversations
# Optional, omit to use the model default.
LLM_TEMPERATURE=

# --- Text to speech (Bulbul) ---
# bulbul:v3 is current; bulbul:v2 and bulbul:v3-beta are also accepted.
TTS_MODEL=bulbul:v3
# Output language: bn-IN, en-IN, gu-IN, hi-IN, kn-IN, ml-IN, mr-IN, od-IN,
# pa-IN, ta-IN, te-IN
TTS_LANGUAGE=hi-IN
# Voice. The roster is per-model -- v3 replaced the v2 voices entirely, so a
# v2 name like anushka is rejected on v3. Leave unset to get a sensible default
# for whichever TTS_MODEL you chose.
#   bulbul:v3  female: ritu, pooja, simran, kavya, ishita, shreya, priya, neha,
#                      roopa, amelia, sophia, suhani, rupali, tanya, shruti,
#                      kavitha
#              male:   shubh, rahul, amit, ratan, rohan, dev, manan, sumit,
#                      aditya, kabir, varun, aayan, ashutosh, advait
#   bulbul:v2  female: anushka, manisha, vidya, arya
#              male:   abhilash, karun, hitesh
TTS_SPEAKER=ritu
# Speaking rate. 1.0 is normal; below 1 is slower, above 1 is faster.
TTS_PACE=1.0

# --- Per-call cost ceiling ---
# A hard limit on what one call may cost, in INR. 0 disables it.
# The call is costed continuously and wound down in stages so it ends
# gracefully rather than cutting out: the agent is first told to be brief,
# then says a closing line and hangs up.
#
# A ceiling also implies a minimum duration: at Rs 30/10k characters an agent
# talking non-stop spends about Rs 2.70/min, so Rs 10 buys at least ~3 minutes
# even in the worst case, and considerably longer in a real conversation.
CALL_BUDGET_INR=0

# A ceiling on cost per MINUTE, which is what a per-minute price depends on.
# 0 disables it. Unlike CALL_BUDGET_INR this never ends the call -- when the
# rate drifts over, the agent is told to be terser until it comes back down.
# The only lever is how much the agent says: speech-to-text costs Rs 0.50/min
# whatever happens, so a ceiling at or below that is rejected.
MAX_INR_PER_MIN=0
# Fractions of the budget at which each stage trips. The wrap stage also trips
# early if only enough budget remains to say goodbye, whichever comes first.
CALL_BUDGET_WARN_AT=0.70
CALL_BUDGET_WRAP_AT=0.90
# What the agent says as it ends a call that has hit its budget.
CALL_BUDGET_FAREWELL=

# Caps the length of any single reply, which caps TTS -- the largest line item.
# The most effective single lever on cost variance. Unset leaves it unbounded.
# 120 tokens is roughly 2-3 spoken sentences.
MAX_RESPONSE_TOKENS=

# --- Personality ---
# One of: assistant, cheerful, concise, professional, support, tutor, kbs
# kbs is Simran, the inbound enquiry desk for KBS Motors (Mahindra, Ambala).
# It is a complete call script and ignores the shared voice rules.
AGENT_PERSONA=assistant

# Optional. Replaces the persona's character with your own prompt. The shared
# voice rules (no markdown, stay brief, one question at a time) are always kept.
AGENT_INSTRUCTIONS=
# Optional. Overrides the persona's opening line.
AGENT_GREETING=

# The clock the agent runs on. A prompt that branches on the time of day needs
# the caller's local time, not the server's. Any IANA zone name.
AGENT_TIMEZONE=Asia/Kolkata

# --- Turn detection ---
# Semantic end-of-turn detection layered on top of VAD. It reads the words and
# prosody in the trailing silence, so a mid-sentence pause is not mistaken for
# the end of a turn. Runs on its own model, independent of Sarvam.
# Set to false for plain VAD silence endpointing.
USE_TURN_DETECTOR=true

# Voice activity detection (Silero, runs locally).
# Trailing silence before end of speech is reported. Must be >= 0.25 while
# USE_TURN_DETECTOR is on: the semantic model classifies that trailing audio.
VAD_MIN_SILENCE_DURATION=0.25
# Audio shorter than this is not treated as speech. Filters out clicks/coughs.
VAD_MIN_SPEECH_DURATION=0.05
# Speech probability needed to trigger. Raise toward 1.0 in noisy rooms.
VAD_ACTIVATION_THRESHOLD=0.5
# Audio retained before speech starts, so the first word is not clipped.
VAD_PREFIX_PADDING_DURATION=0.5

# How long to wait before committing the user's turn. Defaults adapt to the
# mode: 0.3-2.5s with the semantic detector, 0.5-3.0s with VAD alone.
ENDPOINTING_MIN_DELAY=
ENDPOINTING_MAX_DELAY=

# --- Telephony (Plivo over SIP) ---
# Off by default: without it the agent is reachable over WebRTC only.
# Turning it on lets callers reach the agent on a real phone number, and lets
# the agent place calls out. Run `uv run telephony` after filling this in.
#
# Plivo bills PSTN minutes separately from Sarvam and LiveKit. The cost lines
# this project prints cover the models only.
TELEPHONY_ENABLED=false

# Your Plivo numbers, E.164, comma separated. These scope the inbound trunk
# and supply the caller ID on outbound calls.
PLIVO_PHONE_NUMBERS=

# Plivo's SIP zone for calls you place: ap, us or eu (or a full hostname).
# ap is ap.sip.plivo.com, which is the one for Indian numbers.
PLIVO_SIP_ZONE=ap

# Credentials from your Plivo Zentrunk credentials list. The same pair
# authenticates both directions. Required unless PLIVO_ALLOWED_ADDRESSES is
# set -- an inbound trunk with neither accepts SIP from anyone who finds the
# URI, and you are billed for those calls.
PLIVO_SIP_USERNAME=
PLIVO_SIP_PASSWORD=

# Optional. Plivo signalling IPs allowed to reach the inbound trunk, comma
# separated. Narrows the blast radius further; credentials are the main control.
PLIVO_ALLOWED_ADDRESSES=

# The name this worker registers under, so a SIP dispatch rule can target it
# explicitly. Set it and run the worker with the same name. Leaving it unset
# falls back to automatic dispatch, which is fine for a single agent and
# ambiguous once two share a LiveKit project.
TELEPHONY_AGENT_NAME=

# Inbound calls each get their own room, named with this prefix.
TELEPHONY_ROOM_PREFIX=call

# Noise cancellation tuned for phone audio. Phone lines are narrowband and
# noisy in a way a laptop mic is not, so this matters more here than on WebRTC.
TELEPHONY_KRISP=true

# A hard wall-clock cap on one phone call, in seconds. Unset for no limit.
# Independent of CALL_BUDGET_INR: this bounds duration, not spend. Worth
# setting even with a budget, since a silent call costs almost nothing and
# would otherwise stay open.
TELEPHONY_MAX_CALL_SECONDS=

# How long to ring an outbound call before giving up, in seconds.
TELEPHONY_RINGING_SECONDS=

# --- Control plane (multi-tenant) ---
# Where the worker fetches an agent's configuration at the start of a call, and
# posts transcripts and usage back. Leave INTERNAL_API_SECRET unset for local
# single-tenant development: the worker then uses the settings above instead.
#
# When it IS set, a call that cannot be resolved is ended rather than answered.
# There is no safe fallback -- answering with whatever configuration is at hand
# would put a caller through to a different company's script.
CONTROL_PLANE_URL=http://localhost:3000
INTERNAL_API_SECRET=
