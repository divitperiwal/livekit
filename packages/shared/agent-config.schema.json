{
  "$defs": {
    "AnalysisField": {
      "additionalProperties": false,
      "description": "One value to pull out of a finished call: a callback time, a budget.\n\nSingle-word keys, for the same reason as :class:`TransferTarget`.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Name",
          "type": "string"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "title": "Description",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "AnalysisField",
      "type": "object"
    },
    "ClosingLine": {
      "additionalProperties": false,
      "description": "The line that closes a call during some hours of the day.\n\nHours are in the agent's timezone, ``start`` inclusive and ``end``\nexclusive. A row whose ``start`` is after its ``end`` runs through\nmidnight, and one where they are equal covers the whole day -- so no pair\nof hours is invalid, and there is no cross-field rule for the control\nplane's schema to miss. The first row that matches wins.\n\n``{{caller_name}}`` in the text is the name the model heard; missing, it\nrenders as nothing.",
      "properties": {
        "start": {
          "maximum": 23,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 24,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "ClosingLine",
      "type": "object"
    },
    "TransferTarget": {
      "additionalProperties": false,
      "description": "Somewhere the agent may hand a phone call over to.\n\nField names are single words on purpose: the control plane converts only\ntop-level keys between camelCase and snake_case, so a nested key that\nneeded converting would be read differently on each side.",
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "number": {
          "pattern": "^\\+[1-9][0-9]{6,14}$",
          "title": "Number",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 300,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "number"
      ],
      "title": "TransferTarget",
      "type": "object"
    }
  },
